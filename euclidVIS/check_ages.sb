#!/bin/bash -l
#
# Memory-Optimized Full Spectrum Generation
#
#SBATCH -J COMP_SPEC
#SBATCH -o /u/mhuertas/data/synthesizer/logs/out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --time=01:00:00

module purge
module load anaconda/3/2023.03

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# Run the memory-optimized spectrum generation
python3 ./check_ages.py 
