#!/bin/bash -l
#
# Production-level resources for Diagnostic job.
#
#SBATCH -J DIAG_FULL
#SBATCH -o /u/mhuertas/data/synthesizer/logs/out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera 
#SBATCH --ntasks=1 
#SBATCH --cpus-per-task=72 
#SBATCH --mem=240000MB 
#SBATCH --time=04:00:00

module purge
module load anaconda/3/2023.03

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# Use 8 threads for particle-level calculations within the script
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Run the diagnostic script
python3 ./check_ages.py 
