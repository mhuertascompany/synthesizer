#!/bin/bash -l
#
# Inspection job script for VERA
#
#SBATCH -J INSPECT
#SBATCH -o /u/mhuertas/data/synthesizer/logs/inspect.%j.out
#SBATCH -e /u/mhuertas/data/synthesizer/logs/inspect.%j.err
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16000MB
#SBATCH --time=00:30:00

module purge
module load anaconda/3/2023.03

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# Check for argument
if [ -z "$1" ]; then
    echo "Error: Please provide a Subhalo ID argument."
    echo "Usage: sbatch inspect.sb <subhalo_id>"
    exit 1
fi

echo "Running inspection for Subhalo $1..."
python3 inspect_subhalo.py "$@"
