#!/bin/bash -l
# Apply matched DESI DR1 coadd IVAR/masks to completed Popeye raw spectra.
# Submit through popeye_submit_dr1_noise.sh.

#SBATCH -J DESI_DR1_NOISE
#SBATCH -p genx
#SBATCH --constraint=rocky9
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00

set -euo pipefail

module purge
module load python/3.11.11

SCRIPT_DIR="${POPEYE_SCRIPT_DIR:-${SLURM_SUBMIT_DIR:?Set POPEYE_SCRIPT_DIR}}"
PYTHON_BIN="${POPEYE_DESI_PYTHON:-/mnt/home/${USER}/.venvs/desi-noise/bin/python}"
FEASIBGS_ROOT="${POPEYE_FEASIBGS_ROOT:-/mnt/home/${USER}/python/feasiBGS}"
export DESIMODEL="${DESIMODEL:-/mnt/sdceph/users/${USER}/desimodel}"
export PYTHONPATH="${FEASIBGS_ROOT}:${SCRIPT_DIR}:${PYTHONPATH:-}"

MANIFEST="${1:?Pass the DR1 donor-assigned manifest}"
OUTPUT_ROOT="${2:?Pass the root containing sn*/DESI/*_raw.fits}"
N_JOBS="${3:-${SLURM_CPUS_PER_TASK}}"
LIMIT="${4:-}"

if [[ ! -f "${MANIFEST}" ]]; then
    echo "ERROR: DR1 donor manifest not found: ${MANIFEST}" >&2
    exit 1
fi
if [[ ! -d "${DESIMODEL}/data" ]]; then
    echo "ERROR: desimodel calibration data not found: ${DESIMODEL}/data" >&2
    exit 1
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

ARGS=(
    --config "${SCRIPT_DIR}/config_matched.yaml"
    --manifest "${MANIFEST}"
    --output-root "${OUTPUT_ROOT}"
    --n-jobs "${N_JOBS}"
)
if [[ -n "${LIMIT}" ]]; then
    ARGS+=(--limit "${LIMIT}")
fi
if [[ "${POPEYE_DR1_OVERWRITE:-0}" == "1" ]]; then
    ARGS+=(--overwrite --backup-existing)
fi

cd "${SCRIPT_DIR}"
"${PYTHON_BIN}" ./apply_edr_noise_to_existing_mocks.py "${ARGS[@]}"
