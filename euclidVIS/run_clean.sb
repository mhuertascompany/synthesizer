#!/bin/bash
#SBATCH --job-name=clean_cat
#SBATCH -o /u/mhuertas/data/synthesizer/logs/clean.out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/clean.err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:10:00

module purge
module load anaconda/3/2023.03
source /u/mhuertas/python/envs/synth/bin/activate

python3 ./clean_catalog.py
