#!/bin/bash
#SBATCH --job-name=gen_summary
#SBATCH -o /u/mhuertas/data/synthesizer/logs/summary.out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/summary.err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=00:30:00

module purge
module load anaconda/3/2023.03

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

python3 ./generate_summary_pdf.py
