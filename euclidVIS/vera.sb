#!/bin/bash -l
#
# Multi-core job script for MPCDF VERA.
#
#SBATCH -J EUCLID_VIS
#SBATCH -o /u/mhuertas/data/synthesizer/logs/out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera          # Use default partition for exclusive node access
#SBATCH --ntasks=1         # One task (the python script)
#SBATCH --cpus-per-task=72 # Use 72 cores (full node)
#SBATCH --mem=240000MB     # Reduced to fit p.vera limit (250GB)
#SBATCH --time=24:00:00    # 24 hours

module purge
module load anaconda/3/2023.03

# Set number of threads for parallelized synthesizer calls
# We set this to 8 because we run 9 parallel jobs (9 * 8 = 72 cores)
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# feasiBGS is an optional source checkout; override FEASIBGS_ROOT if needed.
FEASIBGS_ROOT="${FEASIBGS_ROOT:-/u/mhuertas/python/feasiBGS}"
export PYTHONPATH="${FEASIBGS_ROOT}:${PYTHONPATH:-}"

# Run the program with force_overwrite to start from scratch with metadata
python3 ./generate_euclid_vis.py --force_overwrite
