#!/bin/bash -l
#
# Multi-core job script for MPCDF VERA.
#
#SBATCH -J EUCLID_VIS
#SBATCH -o /u/mhuertas/data/synthesizer/logs/out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.standard      # Use standard partition for full node
#SBATCH --ntasks=1         # One task (the python script)
#SBATCH --cpus-per-task=72 # Use 72 cores (full node)
#SBATCH --mem=256000MB     # 256GB for full snapshot
#SBATCH --time=24:00:00    # 24 hours

module purge
module load anaconda/3/2023.03

# Set number of threads for parallelized synthesizer calls
export OMP_NUM_THREADS=72
export MKL_NUM_THREADS=72
export OPENBLAS_NUM_THREADS=72

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# Add local synthesizer to path to pick up bugfixes
export PYTHONPATH=/u/mhuertas/python/synthesizer/src:$PYTHONPATH

# Run the program
srun python3 ./generate_euclid_vis.py