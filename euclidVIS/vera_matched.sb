#!/bin/bash -l
# Usage: sbatch vera_matched.sb [number_of_mocks] [seed]
# Example test: sbatch vera_matched.sb 10 42

#SBATCH -J EUCLID_MATCHED
#SBATCH -o /u/mhuertas/data/synthesizer/logs/matched.%j.out
#SBATCH -e /u/mhuertas/data/synthesizer/logs/matched.%j.err
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=72
#SBATCH --mem=240000MB
#SBATCH --time=24:00:00

module purge
module load anaconda/3/2023.03
source /u/mhuertas/python/envs/synth/bin/activate

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8

N_MOCKS="${1:-100}"
SEED="${2:-42}"

python3 ./generate_matched_sample.py \
    --config ./config_matched.yaml \
    --n_mocks "${N_MOCKS}" \
    --seed "${SEED}"
