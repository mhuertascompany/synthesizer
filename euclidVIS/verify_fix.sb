#!/bin/bash -l
#
# Verification job script for MPCDF VERA.
#
#SBATCH -J VERIFY_HA
#SBATCH -o /u/mhuertas/data/synthesizer/logs/out.%j
#SBATCH -e /u/mhuertas/data/synthesizer/logs/err.%j
#SBATCH -D /u/mhuertas/python/synthesizer/euclidVIS
#SBATCH -p p.vera
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=02:00:00

module purge
module load anaconda/3/2023.03

# activate virtual environment
source /u/mhuertas/python/envs/synth/bin/activate

# Process only subhalo 96768 with a fixed observation z
# This is our known test case with young stars in the FOV.
python3 ./generate_euclid_vis.py --subhalo_ids 300929 --z_obs 0.3 --force_overwrite
